# Optional: for `agents-eval --live` (and the embedding line below). The demo, the tests
# and CI run fully offline with deterministic fakes and need none of them.

# Interviewer and simulated user (Anthropic).
ANTHROPIC_API_KEY=YOUR_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5-5

# Judge: any OpenAI-compatible endpoint, ideally a different model family
# from the interviewer (the harness refuses a same-family judge).
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=YOUR_MODEL_NAME
OPENAI_FAMILY=openai
# Optional: OpenAICompatibleEmbedder (llm/openai_live.py) reads this when you wire real
# embeddings into the knowledge role yourself; agents-eval does not use it.
OPENAI_EMBED_MODEL=YOUR_EMBEDDING_MODEL_NAME
